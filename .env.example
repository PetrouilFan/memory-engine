# Memory Engine Configuration
# Copy this file to .env and fill in your values.

# --- Storage paths ---
# MEMORY_DB_PATH=data/memory.db
# MEMORY_INDEX_PATH=data/memory.index
# MEMORY_EMB_DIM=384

# --- Performance ---
# INDEX_SAVE_INTERVAL=100
# DB_POOL_SIZE=5

# --- Hallucination Filtering ---
# MEMORY_FILTER_HALLUCINATIONS=true
# MEMORY_HALLUCINATION_THRESHOLD=0.5

# --- Memory Bridge (required for memory_bridge.py) ---
GROQ_API_KEY=your_groq_api_key_here

# --- REST API ---
# MEMORY_API_HOST=0.0.0.0
# MEMORY_API_PORT=8000
# MEMORY_API_ADMIN_TOKEN=your_admin_token_here

# --- Optional: PostgreSQL backend ---
# POSTGRES_URL=postgresql://user:password@localhost:5432/memory
