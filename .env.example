# Memory Engine Configuration
# Copy this file to .env and fill in your values.

# --- Storage paths ---
# MEMORY_DB_PATH=data/memory.db
# MEMORY_INDEX_PATH=data/memory.index
# MEMORY_EMB_DIM=384

# --- Database ---
# DB_POOL_SIZE=5
# DB_TIMEOUT=30.0
# DB_ENABLE_WAL=true

# --- FAISS Index Optimization (CPU) ---
# FAISS_INDEX_TYPE=FlatIP  # FlatIP, HNSW, IVF
# FAISS_HNSW_M=32
# FAISS_HNSW_EF_CONSTRUCTION=200
# FAISS_HNSW_EF_SEARCH=50
# FAISS_IVF_NLIST=100
# FAISS_IVF_NPROBE=10
# FAISS_USE_GPU=false

# --- Embedding Service (CPU-optimized) ---
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_BATCH_SIZE=16  # Lower for limited RAM
# EMBEDDING_USE_ONNX=false  # Enable for faster CPU inference
# CACHE_EMBEDDINGS=true

# --- Performance ---
# INDEX_SAVE_INTERVAL=100

# --- Hallucination Filtering ---
# MEMORY_FILTER_HALLUCINATIONS=true
# MEMORY_HALLUCINATION_THRESHOLD=0.5

# --- Redis Cache ---
# REDIS_URL=redis://localhost:6379/0
# CACHE_TTL_SECONDS=300

# --- Memory Bridge (required) ---
GROQ_API_KEY=your_groq_api_key_here
# TARGET_MODEL=openai/gpt-oss-120b
# BRIDGE_PORT=19192
# MEMORY_RECALL_K=3
# MEMORY_RECALL_THRESHOLD=0.3
# BRIDGE_API_KEY=

# --- REST API ---
# MEMORY_API_HOST=0.0.0.0
# MEMORY_API_PORT=8000
# MEMORY_API_ADMIN_TOKEN=your_admin_token_here
# CORS_ORIGINS=*
# DEBUG=false

# --- Optional: PostgreSQL backend ---
# POSTGRES_URL=postgresql://user:password@localhost:5432/memory
